{
  "name": "mlteacher",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "publish:curriculum": "tsx scripts/publish-curriculum.ts",
    "publish:question-bank": "tsx scripts/publish-question-bank.ts",
    "build:library": "tsx scripts/build-library.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=prod-smoke",
    "curriculum:check": "tsx scripts/curriculum-check.ts",
    "curriculum:new": "tsx scripts/curriculum-new.ts",
    "runtimes:vendor": "tsx scripts/vendor-runtimes.ts",
    "verify": "npm run lint && npm run type-check && npm run test && npm run curriculum:check",
    "harness:generate": "tsx scripts/generate-python-harness.ts",
    "prebuild": "npm run harness:generate && npm run curriculum:artifact && npm run search:index",
    "predev": "npm run harness:generate",
    "search:index": "tsx scripts/build-search-index.ts",
    "curriculum:artifact": "tsx scripts/build-curriculum-artifact.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
